{
  "name": "scele-course-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter ./core --filter ./ui run dev",
    "build": "pnpm --recursive --filter ./core --filter ./ui run build",
    "test": "vitest run",
    "format": "prettier --write \"{core/src,ui/src,tests}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{core/src,ui/src,tests}/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^27.0.0",
    "jsonwebtoken": "^9.0.3",
    "prettier": "^3.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "supertest": "^7.2.0",
    "vitest": "^4.1.0"
  }
}
